# =========================
# 基础运行环境
# =========================
APP_NAME=ozon-ai-selection-system
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
TIMEZONE=Asia/Shanghai

# =========================
# 路径配置
# =========================
DATA_DIR=data
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
EXPORT_DIR=data/exports
LOG_DIR=logs

# =========================
# Anthropic Claude API
# =========================
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_TIMEOUT_SECONDS=60

# =========================
# OpenAI / GPT 商品解析
# =========================
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_PRODUCT_PARSE_MODEL=gpt-5.4
OPENAI_TIMEOUT_SECONDS=60
PRODUCT_PARSER_JSON_RETRY_COUNT=2
PRODUCT_PARSER_IMAGE_DOWNLOAD_TIMEOUT_SECONDS=20
PRODUCT_PARSER_IMAGE_REFERER=https://www.ozon.ru/
PRODUCT_PARSER_IMAGE_USER_AGENT=
PRODUCT_PARSER_IMAGE_ACCEPT_LANGUAGE=ru-RU,ru;q=0.9,en;q=0.8,zh-CN;q=0.7
PRODUCT_PARSER_TEST_OUTPUT_DIR=data/exports/product_parser
PRODUCT_PARSER_TEST_IMAGE_DIR=data/raw/product_parser_test_images

# =========================
# 1688 第三方 API
# =========================
API1688_BASE_URL=
API1688_APP_KEY=your_1688_app_key
API1688_APP_SECRET=your_1688_app_secret
API1688_TIMEOUT_SECONDS=60
API1688_AUTH_MODE=query
API1688_IMAGE_SEARCH_PATH=/image_search
API1688_IMAGE_SEARCH_METHOD=POST
API1688_IMAGE_SEARCH_PAYLOAD_MODE=image_url
API1688_IMAGE_SEARCH_IMAGE_URL_FIELD=image_url
API1688_IMAGE_SEARCH_IMAGE_BASE64_FIELD=image_base64
API1688_IMAGE_SEARCH_PAGE_FIELD=page
API1688_IMAGE_SEARCH_PAGE_SIZE_FIELD=page_size
API1688_IMAGE_SEARCH_DEFAULT_PAGE_SIZE=20
API1688_IMAGE_SEARCH_RESULTS_PATH=data.items

# =========================
# 1688 浏览器图搜图
# =========================
ALIBABA1688_BASE_URL=https://www.1688.com
ALIBABA1688_LOGIN_URL=https://login.1688.com/
ALIBABA1688_IMAGE_SEARCH_URL=https://s.1688.com/youyuan/index.htm
ALIBABA1688_IMAGE_SEARCH_TAB=imageSearch
ALIBABA1688_ADSPOWER_API_URL=
ALIBABA1688_ADSPOWER_API_KEY=
ALIBABA1688_ADSPOWER_PROFILE_ID=
ALIBABA1688_CDP_URL=
ALIBABA1688_USER_DATA_DIR=browser-profile-1688
ALIBABA1688_AUTH_STATE_FILE=auth-state-1688.json
ALIBABA1688_WAIT_AFTER_LOGIN_MS=3000
ALIBABA1688_LOGIN_TIMEOUT_SECONDS=180
ALIBABA1688_RESULT_WAIT_MS=5000
ALIBABA1688_MAX_RESULTS=20
ALIBABA1688_OPEN_RETRY_COUNT=3
ALIBABA1688_RETRY_WAIT_MS=3000
ALIBABA1688_IMAGE_COMPARE_PASS_SCORE=60
ALIBABA1688_DETAIL_RATE_LIMIT_COUNT=6
ALIBABA1688_DETAIL_RATE_LIMIT_WINDOW_SECONDS=60

# =========================
# SQLite / Supabase 数据库
# =========================
SQLITE_PATH=data/processed/ozon_selection.db
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_SCHEMA=public

# =========================
# Ozon / Playwright 采集
# =========================
OZON_BASE_URL=https://www.ozon.ru
OZON_START_URLS=https://www.ozon.ru/
OZON_MARKET=RU
OZON_LANGUAGE=ru
OZON_USER_AGENT=
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_CHANNEL=
PLAYWRIGHT_EXECUTABLE_PATH=
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=45000
PLAYWRIGHT_SLOW_MO_MS=0
PLAYWRIGHT_PROXY_URL=
OZON_BROWSER_LOCALE=ru-RU
OZON_BROWSER_TIMEZONE=Europe/Moscow
SHOPBANG_HEADLESS=false
ALIBABA1688_HEADLESS=true

# =========================
# Ozon 选品抓取参数
# =========================
OZON_SCRAPE_KEYWORD=Виброхвост
OZON_SCRAPE_TARGET_PRODUCTS=2000
OZON_SCRAPE_SORTING=rating
OZON_SCRAPE_FROM_GLOBAL=true
OZON_SCRAPE_SCROLL_STEP_PX=800
OZON_SCRAPE_SCROLL_PAUSE_MS=800
OZON_SCRAPE_STALE_LIMIT=6
OZON_SCRAPE_PLUGIN_WAIT_MS=4000
OZON_SCRAPE_IMAGE_WAIT_MS=1000
OZON_SCRAPE_DOWNLOAD_IMAGES=true
OZON_SCRAPE_OUTPUT_DIR=data/exports
OZON_SCRAPE_IMAGE_DIR=data/raw/product_images
OZON_KEYWORD_TIMEOUT_SECONDS=1800

# =========================
# 上品帮插件 / 登录态
# =========================
SHOPBANG_EXTENSION_ID=ffnehecempjlbkejkmmdeenbodnafjdj
SHOPBANG_CHROME_VERSION=120.0.0.0
SHOPBANG_EXTENSION_DIR=extensions
SHOPBANG_EXTENSION_CRX_PATH=extensions/ffnehecempjlbkejkmmdeenbodnafjdj.crx
SHOPBANG_EXTENSION_UNPACK_DIR=extensions/unpacked
SHOPBANG_LOGIN_URL=https://shopbang.cn/
SHOPBANG_ERP_URL=https://shopbang.cn/erp/#/index
SHOPBANG_ERP_LOGIN_URL=https://shopbang.cn/erp/#/login
SHOPBANG_REMAI_URL=https://shopbang.cn/erp/#/remai
SHOPBANG_HISTORY_URL=https://shopbang.cn/erp/#/history
SHOPBANG_CDP_URL=
SHOPBANG_CDP_PORT=9222
SHOPBANG_CDP_BROWSER_PATH=
SHOPBANG_CDP_USER_DATA_DIR=browser-profile-cdp
SHOPBANG_AUTH_CHECK_URL=https://plus.shopbang.cn/api/order/ozon/getLocalNewOrder
SHOPBANG_USERNAME=
SHOPBANG_PASSWORD=
SHOPBANG_USER_DATA_DIR=browser-profile
SHOPBANG_AUTH_STATE_FILE=auth-state.json
SHOPBANG_DOWNLOAD_TIMEOUT_SECONDS=120
SHOPBANG_LOGIN_TIMEOUT_SECONDS=30

# =========================
# Streamlit 审核面板
# =========================
STREAMLIT_HOST=0.0.0.0
STREAMLIT_PORT=8501
STREAMLIT_USERNAME=admin
STREAMLIT_PASSWORD=change_me

# =========================
# APScheduler 任务调度
# =========================
SCHEDULER_TIMEZONE=Asia/Shanghai
COLLECT_OZON_CRON=*/30 * * * *
SYNC_1688_CRON=0 */2 * * *
RUN_AI_ANALYSIS_CRON=15 */2 * * *
PUSH_REVIEW_QUEUE_CRON=30 */2 * * *

# =========================
# 业务规则参数
# =========================
DEFAULT_EXCHANGE_RATE_CNY_TO_RUB=12.80
MIN_EXPECTED_MARGIN=0.25
MAX_1688_PURCHASE_PRICE_CNY=300
MIN_OZON_MONTHLY_ORDERS=30
